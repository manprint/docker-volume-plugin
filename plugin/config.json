{
  "description": "dvol: docker volume plugin with backup/restore",
  "documentation": "https://github.com/fabio/dvol",
  "entrypoint": ["/dvol-plugin", "-root", "/data"],
  "interface": {
    "types": ["docker.volumedriver/1.0"],
    "socket": "dvol.sock"
  },
  "linux": {
    "capabilities": ["CAP_SYS_ADMIN"]
  },
  "mounts": [
    {
      "name": "dvol-data",
      "type": "bind",
      "source": "/var/lib/dvol",
      "destination": "/data"
    }
  ],
  "propagatedMount": "/data"
}
